generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  password                String
  avatarUrl               String?
  shareToken              String?                   @unique
  emailVerified           Boolean                   @default(false)
  failedLoginAttempts     Int                       @default(0)
  lockedUntil             DateTime?
  isAdmin                 Boolean                   @default(false)
  lastLoginAt             DateTime?
  lastActiveAt            DateTime?
  twoFactorSecret         String?
  twoFactorEnabled        Boolean                   @default(false)
  createdAt               DateTime                  @default(now())
  checkIns                DailyCheckIn[]
  routines                Routine[]
  resetTokens             PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  trustedDevices          TrustedDevice[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  subject   String
  message   String
  type      String   @default("other")
  status    String   @default("open")
  createdAt DateTime @default(now())

  @@index([status])
  @@index([email])
}

model Routine {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  days      RoutineDay[]

  @@index([deletedAt])
}

model RoutineDay {
  id           String        @id @default(cuid())
  routineId    String
  routine      Routine       @relation(fields: [routineId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  muscleGroups MuscleGroup[]

  @@unique([routineId, dayOfWeek])
}

model MuscleGroup {
  id           String     @id @default(cuid())
  routineDayId String
  routineDay   RoutineDay @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  name         String
  order        Int        @default(0)
  exercises    Exercise[]
}

model Exercise {
  id                 String       @id @default(cuid())
  muscleGroupId      String
  muscleGroup        MuscleGroup  @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)
  name               String
  imageUrl           String?
  imageSource        String?
  imageLicenseAuthor String?
  imageLicenseUrl    String?
  imageSourceUrl     String?
  targetSets         Int          @default(3)
  targetReps         Int          @default(10)
  targetWeight       Float?
  order              Int          @default(0)
  createdAt          DateTime     @default(now())
  deletedAt          DateTime?
  logs               WorkoutLog[]

  @@index([name])
  @@index([deletedAt])
}

model ExerciseImageTemplate {
  id               String   @id @default(cuid())
  exerciseName     String
  imageUrl         String
  license          String
  licenseTitle     String?
  licenseAuthor    String?
  licenseAuthorUrl String?
  sourceUrl        String
  createdAt        DateTime @default(now())

  @@index([exerciseName])
}

model WorkoutLog {
  id          String   @id @default(cuid())
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  notes       String?
  performedAt DateTime @default(now())
  sets        SetLog[]
}

model SetLog {
  id           String     @id @default(cuid())
  workoutLogId String
  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  setNumber    Int
  weight       Float
  reps         Int
}

model DailyCheckIn {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String
  difficulty Int
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
}